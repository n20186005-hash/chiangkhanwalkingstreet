---
import { getLangFromUrl, getI18n, languagesList } from '../../i18n/ui';
import { attractions, pick } from '../../data/attractions';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;

const a = attractions[0];
---
<BaseLayout title={m.brand.name} description={m.home.subtitle} path="" >
  <Header lang={lang} nav={[]} />
  <main>
    <section class="explore-hero" style={{ backgroundImage: `linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url(/gallery/${a.slug}-1.jpg)`, backgroundSize: 'cover', backgroundPosition: 'center', color: 'white', padding: '6rem 1rem', textAlign: 'center' }}>
      <h1 class="explore-title" style="color: white;">{pick(a.name, lang)}</h1>
      <p class="explore-sub" style="color: rgba(255,255,255,0.9);">{pick(a.tagline, lang)}</p>
      <div style="margin-top: 2rem;">
        <a href={`/${lang}/attraction/${a.slug}`} class="btn-line" style="color: white; border-color: white; text-decoration: none; padding: 0.75rem 1.5rem; display: inline-block;">{m.common.explore}</a>
      </div>
    </section>

    <div class="container" style="padding: 4rem 1rem; max-width: 800px; text-align: center;">
      <h2>{m.brand.tagline}</h2>
      <p style="margin-top: 1rem; line-height: 1.8; color: var(--text-light);">{pick(a.intro, lang)}</p>
      <div style="margin-top: 3rem;">
        <a class="poi-card" href={`/${lang}/attraction/${a.slug}`} style="text-align: left; max-width: 400px; margin: 0 auto; display: block;">
          <img class="poi-card-img" src={`/gallery/${a.slug}-2.jpg`} alt={pick(a.name, lang)} loading="lazy" />
          <div class="poi-card-body">
            <p class="poi-card-name">{pick(a.name, lang)}</p>
            <p class="poi-card-loc">{a.city}, {a.province}</p>
            <div class="poi-card-tags">
              {a.category.slice(0, 3).map((c) => <span>{c}</span>)}
            </div>
          </div>
        </a>
      </div>
    </div>
  </main>
  <Footer poi={a} lang={lang} />
</BaseLayout>
