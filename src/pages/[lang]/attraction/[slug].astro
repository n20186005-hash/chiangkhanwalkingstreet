---
import { getLangFromUrl, getI18n, languagesList } from '../../../i18n/ui';
import { attractions, getAttraction, pick } from '../../../data/attractions';
import { siteConfig } from '../../../config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import AttractionHero from '../../../components/AttractionHero.astro';
import Overview from '../../../components/Overview.astro';
import QuickFacts from '../../../components/QuickFacts.astro';
import PracticalAnswers from '../../../components/PracticalAnswers.astro';
import WhyVisit from '../../../components/WhyVisit.astro';
import ThingsToDo from '../../../components/ThingsToDo.astro';
import WalkingRoutes from '../../../components/WalkingRoutes.astro';
import BestTime from '../../../components/BestTime.astro';
import RoutePlanner from '../../../components/RoutePlanner.astro';
import FoodGuide from '../../../components/FoodGuide.astro';
import NearbyPlaces from '../../../components/NearbyPlaces.astro';
import Culture from '../../../components/Culture.astro';
import HistoryTimeline from '../../../components/HistoryTimeline.astro';
import CommunityPreservation from '../../../components/CommunityPreservation.astro';
import LocalVoices from '../../../components/LocalVoices.astro';
import Photography from '../../../components/Photography.astro';
import Accessibility from '../../../components/Accessibility.astro';
import FAQ from '../../../components/FAQ.astro';
import Map from '../../../components/Map.astro';
import Gallery from '../../../components/Gallery.astro';
import VisitorSummary from '../../../components/VisitorSummary.astro';
import Weather from '../../../components/Weather.astro';
import SeasonMatrix from '../../../components/SeasonMatrix.astro';
import DayPlans from '../../../components/DayPlans.astro';
import AudiencePlans from '../../../components/AudiencePlans.astro';
import Facilities from '../../../components/Facilities.astro';
import DeepDive from '../../../components/DeepDive.astro';
import Legends from '../../../components/Legends.astro';
import Responsibility from '../../../components/Responsibility.astro';
import Glossary from '../../../components/Glossary.astro';
import { seoTopics } from '../../../data/seo-topics';
import { nearbyGuides } from '../../../data/nearby-guides';

export function getStaticPaths() {
  return languagesList.flatMap((lang) =>
    attractions.map((poi) => ({ params: { lang, slug: poi.slug }, props: { lang, poi } }))
  );
}

const { lang, poi } = Astro.props;
const m = getI18n(Astro.url).messages;
if (!poi) return Astro.redirect('/');

// Written for the queries this page actually earns impressions for: the
// English brand term, the Thai "เปิดวันไหน / กี่โมง" opening-hours intent and
// the "night market" variant. The description answers them in the first line
// rather than restating the title.
const title = m.seo.attractionTitle;
const description = m.seo.attractionDescription;
const path = `attraction/${poi.slug}`;
const breadcrumb = [{ name: pick(poi.name, lang), path }];

const nav = [
  { href: '#overview', label: m.nav.guide },
  { href: '#why-visit', label: m.headings.whyVisit },
  { href: '#get-there', label: m.headings.howToGetThere },
  { href: '#food', label: m.headings.localFood },
  { href: '#map', label: m.nav.map },
];
---
<BaseLayout title={title} description={description} path={path} poi={poi} breadcrumb={breadcrumb} faq rating>
  <Header lang={lang} nav={nav} />
  <main>
    <AttractionHero poi={poi} />
    <Overview poi={poi} />
    <HistoryTimeline poi={poi} />
    <CommunityPreservation poi={poi} />
    <LocalVoices poi={poi} />
    <QuickFacts poi={poi} />
    <PracticalAnswers poi={poi} />
    <Weather poi={poi} />
    <WhyVisit poi={poi} />
    <ThingsToDo poi={poi} />
    <WalkingRoutes poi={poi} />
    <BestTime poi={poi} />
    <SeasonMatrix poi={poi} />
    <DayPlans poi={poi} />
    <AudiencePlans poi={poi} />
    <RoutePlanner poi={poi} />
    <NearbyPlaces poi={poi} />
    <FoodGuide poi={poi} />
    <Facilities poi={poi} />
    <Culture poi={poi} />
    <DeepDive poi={poi} />
    <Legends poi={poi} />
    <Photography poi={poi} />
    <Accessibility poi={poi} />
    <Responsibility poi={poi} />
    <FAQ poi={poi} />
    <Map poi={poi} />
    <Gallery poi={poi} />
    <VisitorSummary poi={poi} />
    <Glossary poi={poi} />
    <section class="section" id="nearby-guides"><div class="container">
      <h2 class="section-title">{{ en:'Nearby attractions to visit', th:'สถานที่ท่องเที่ยวใกล้เคียง', zh:'可顺路参观的周边景点' }[lang]}</h2>
      <div class="card-grid">{nearbyGuides.map(place => <a class="nearby-card" href={`/${lang}/nearby/${place.slug}/`}>
        <img src={place.images[0]} alt={place.name[lang]} loading="lazy" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:.5rem" />
        <h3>{place.name[lang]}</h3><p>{place.subtitle[lang]}</p>
      </a>)}</div>
    </div></section>
    <section class="section section-alt" id="more-guides">
      <div class="container">
        <h2 class="section-title">{{ en: 'More Chiang Khan travel guides', th: 'คู่มือเที่ยวเชียงคานเพิ่มเติม', zh: '更多清刊旅游专题' }[lang]}</h2>
        <div class="card-grid">
          {seoTopics.map(topic => (
            <a class="nearby-card" href={`/${lang}/attraction/${poi.slug}/topic/${topic.slug}/`}>
              <h3>{topic.title[lang]}</h3>
              <p>{topic.intro[lang]}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer poi={poi} lang={lang} />
</BaseLayout>
