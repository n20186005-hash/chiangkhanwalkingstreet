---
import { getLangFromUrl, getI18n, languagesList } from '../../../../i18n/ui';
import { attractions, sectionDefs, getSection, pick } from '../../../../data/attractions';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import RoutePlanner from '../../../../components/RoutePlanner.astro';
import BestTime from '../../../../components/BestTime.astro';
import FoodGuide from '../../../../components/FoodGuide.astro';
import WalkingRoutes from '../../../../components/WalkingRoutes.astro';
import NearbyPlaces from '../../../../components/NearbyPlaces.astro';
import Photography from '../../../../components/Photography.astro';
import Map from '../../../../components/Map.astro';
import Weather from '../../../../components/Weather.astro';
import PracticalAnswers from '../../../../components/PracticalAnswers.astro';
import SeasonMatrix from '../../../../components/SeasonMatrix.astro';
import DayPlans from '../../../../components/DayPlans.astro';
import AudiencePlans from '../../../../components/AudiencePlans.astro';
import Facilities from '../../../../components/Facilities.astro';
import DeepDive from '../../../../components/DeepDive.astro';
import Legends from '../../../../components/Legends.astro';
import Responsibility from '../../../../components/Responsibility.astro';
import Glossary from '../../../../components/Glossary.astro';
import Sources from '../../../../components/Sources.astro';

export function getStaticPaths() {
  return languagesList.flatMap((lang) =>
    attractions.flatMap((poi) =>
      sectionDefs.map((sec) => ({
        params: { lang, slug: poi.slug, section: sec.slug },
        props: { lang, poi, sec },
      }))
    )
  );
}

const { lang, poi, sec } = Astro.props;
const m = getI18n(Astro.url).messages;
// Sub-pages carry their own query-targeted TDK rather than echoing the H1 as
// the description, which is what the section pages did before.
const title = pick(sec.seoTitle, lang);
const description = pick(sec.seoDesc, lang);
const path = `attraction/${poi.slug}/${sec.slug}`;
const guideHref = `/${lang}/attraction/${poi.slug}/`;
const breadcrumb = [
  { name: pick(poi.name, lang), path: `attraction/${poi.slug}` },
  { name: pick(sec.title, lang), path },
];
---
<BaseLayout title={title} description={description} path={path} poi={poi} breadcrumb={breadcrumb}>
  <Header lang={lang} nav={[{ href: guideHref, label: m.nav.guide }]} />
  <main>
    <section class="section">
      <div class="container">
        <p class="breadcrumb">
          <a href={`/${lang}/`}>{m.nav.home}</a> ›
          <a href={guideHref}>{pick(poi.name, lang)}</a> ›
          <span>{pick(sec.title, lang)}</span>
        </p>
        <h1 class="section-title" style="font-size:2rem;">{pick(sec.title, lang)}</h1>

        {sec.focus === 'transport' && <RoutePlanner poi={poi} fromFilter={sec.transportFrom} />}
        {sec.focus === 'bestTime' && <BestTime poi={poi} />}
        {sec.focus === 'food' && <FoodGuide poi={poi} />}
        {sec.focus === 'routes' && <WalkingRoutes poi={poi} />}
        {sec.focus === 'nearby' && <NearbyPlaces poi={poi} />}
        {sec.focus === 'photography' && <Photography poi={poi} />}
        {sec.focus === 'weather' && <Weather poi={poi} />}
        {sec.focus === 'seasons' && <SeasonMatrix poi={poi} />}
        {sec.focus === 'plans' && (
          <>
            <DayPlans poi={poi} />
            <AudiencePlans poi={poi} />
          </>
        )}
        {sec.focus === 'services' && <Facilities poi={poi} />}
        {sec.focus === 'science' && (
          <>
            <DeepDive poi={poi} />
            <Legends poi={poi} />
            <Responsibility poi={poi} />
            <Glossary poi={poi} />
          </>
        )}
        {sec.focus === 'hours' && <PracticalAnswers poi={poi} />}
      </div>
    </section>

    <Map poi={poi} />
    <Sources poi={poi} />

    <section class="section section-alt">
      <div class="container">
        <a class="btn-line" href={guideHref}>← {m.common.backToGuide}</a>
      </div>
    </section>
  </main>
  <Footer poi={poi} lang={lang} />
</BaseLayout>
