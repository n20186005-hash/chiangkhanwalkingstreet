---
import { languagesList, getI18n } from '../../../i18n/ui';
import { attractions, pick } from '../../../data/attractions';
import { nearbyGuides } from '../../../data/nearby-guides';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export function getStaticPaths() {
  return languagesList.flatMap(lang => nearbyGuides.map(place => ({ params: { lang, place: place.slug }, props: { lang, place } })));
}
const { lang, place } = Astro.props;
const poi = attractions[0];
const m = getI18n(Astro.url).messages;
const l = { en: { about: 'About this attraction', basics:'Essential information', hours:'Opening hours & admission', history:'History and background', route:'What to see and how to explore', faq:'Visitor questions', gallery:'Real photographs', transport:'Location and directions', nearby:'Continue exploring', management:'Visiting and local stewardship', verify:'Confirm current opening times, access, and any fees at the site.', photos:'Photography', place:'Place', category:'Type', map:'Open this exact place in Google Maps', home:'Back to the walking street' }, th: { about:'เกี่ยวกับสถานที่',basics:'ข้อมูลพื้นฐาน',hours:'เวลาเปิดและค่าเข้าชม',history:'ประวัติและความเป็นมา',route:'จุดชมและวิธีเที่ยว',faq:'คำถามที่พบบ่อย',gallery:'ภาพถ่ายสถานที่จริง',transport:'ที่ตั้งและเส้นทาง',nearby:'เที่ยวต่อใกล้เคียง',management:'การเยี่ยมชมและการดูแลพื้นที่',verify:'ตรวจเวลาเปิด การเข้าชม และค่าธรรมเนียมที่หน้างาน',photos:'จุดถ่ายภาพ',place:'สถานที่',category:'ประเภท',map:'เปิดตำแหน่งสถานที่นี้ใน Google Maps',home:'กลับถนนคนเดิน' }, zh: { about:'关于景点',basics:'基本资料',hours:'开放与票务',history:'历史背景',route:'观察重点与游览路线',faq:'访客常见问答',gallery:'景点实景照片',transport:'交通位置与导航',nearby:'继续探索周边',management:'参观与现场管理',verify:'开放时间、进入方式和费用请以现场公告为准。',photos:'拍照机位',place:'名称',category:'类型',map:'在 Google Maps 查看该景点',home:'返回步行街' } }[lang];
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.mapsQuery)}`;
const root = `/${lang}/attraction/${poi.slug}/`;
const path = `nearby/${place.slug}`;
const related = nearbyGuides.filter(item=>item.slug!==place.slug);
---
<BaseLayout title={`${place.name[lang]} | ${pick(poi.name, lang)}`} description={place.introduction[lang]} path={path} poi={poi} breadcrumb={[{ name:pick(poi.name, lang),path:`attraction/${poi.slug}` },{ name:place.name[lang],path }]}>
  <Header lang={lang} nav={[{href:'#about',label:l.about},{href:'#route',label:l.route},{href:'#gallery',label:l.gallery},{href:'#location',label:l.transport}]} />
  <main>
    <section class="section"><div class="container">
      <p class="breadcrumb"><a href={`/${lang}/`}>{m.nav.home}</a> › <a href={root}>{pick(poi.name,lang)}</a> › {place.name[lang]}</p>
      <h1 class="section-title">{place.name[lang]}</h1>
      <p class="section-subtitle">{place.subtitle[lang]}</p>
      <p>{place.introduction[lang]}</p>
      <p style="margin-top:1.5rem"><a class="btn-line" href={maps} target="_blank" rel="noopener noreferrer">{l.map}</a></p>
      <img src={place.images[0]} alt={place.name[lang]} style="margin-top:1.75rem;width:100%;max-height:500px;object-fit:cover;border-radius:1rem" />
    </div></section>
    <section id="about" class="section section-alt"><div class="container">
      <h2 class="section-title">{l.about}</h2>
      <p>{place.introduction[lang]}</p>
      <h3 style="margin-top:1.5rem">{l.management}</h3><p>{place.management[lang]}</p>
      <h2 class="section-title" style="margin-top:2rem">{l.basics}</h2>
      <div class="card-grid">
        <div class="nearby-card"><h3>{l.place}</h3><p>{place.name[lang]}</p></div>
        <div class="nearby-card"><h3>{l.category}</h3><p>{place.category[lang]}</p></div>
        <div class="nearby-card"><h3>{l.transport}</h3><p>{place.location}</p></div>
      </div>
      <h3 style="margin-top:1.5rem">{l.hours}</h3><p>{l.verify}</p>
    </div></section>
    <section class="section"><div class="container">
      <h2 class="section-title">{l.history}</h2><p>{place.history[lang]}</p>
    </div></section>
    <section id="route" class="section section-alt"><div class="container">
      <h2 class="section-title">{l.route}</h2>
      <div class="card-grid">{place.sections.map((block,i) => <article class="nearby-card"><h3>{i+1}. {block.heading[lang]}</h3><p>{block.text[lang]}</p></article>)}</div>
    </div></section>
    <section id="gallery" class="section"><div class="container">
      <h2 class="section-title">{l.gallery}</h2>
      <div class="card-grid">{place.images.map((src,i)=><figure class="nearby-card"><img src={src} alt={`${place.name[lang]} — ${i+1}`} loading="lazy" style="width:100%;border-radius:.5rem;aspect-ratio:4/3;object-fit:cover"/><figcaption>{place.name[lang]} — {i+1}</figcaption></figure>)}</div>
    </div></section>
    <section class="section section-alt"><div class="container">
      <h2 class="section-title">{l.faq}</h2>
      <div class="card-grid">{place.faq.map(item=><article class="nearby-card"><h3>{item.question[lang]}</h3><p>{item.answer[lang]}</p></article>)}</div>
    </div></section>
    <section id="location" class="section"><div class="container">
      <h2 class="section-title">{l.transport}</h2><p>{place.location}</p>
      <p style="margin-top:1rem"><a class="btn-line" href={maps} rel="noopener noreferrer" target="_blank">{l.map}: {place.name[lang]}</a></p>
      <p style="margin-top:1rem"><a href={place.source} target="_blank" rel="noopener noreferrer">{m.headings?.sources ?? 'Source'}</a></p>
      <h2 class="section-title" style="margin-top:2.5rem">{l.nearby}</h2>
      <div class="card-grid">{related.map(item=><a class="nearby-card" href={`/${lang}/nearby/${item.slug}/`}><h3>{item.name[lang]}</h3><p>{item.subtitle[lang]}</p></a>)}</div>
      <p style="margin-top:2rem"><a href={root} class="btn-line">← {l.home}</a></p>
    </div></section>
  </main><Footer poi={poi} lang={lang} />
</BaseLayout>
