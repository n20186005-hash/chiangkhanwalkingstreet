---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const r = messages.reviews;

function stars(n: number) {
  let out = '';
  for (let i = 0; i < 5; i++) out += `<span class="${i < n ? 'star-filled' : 'star-empty'}">★</span>`;
  return out;
}
---

<section id="reviews" class="section-padding" style="background: var(--bg-tertiary);">
  <div class="container-narrow">
    <h2 class="section-title">{r.title}</h2>
    <p class="section-subtitle">{r.declaration}</p>

    <h3 class="feature-title" style="text-align:center; margin-bottom:1.25rem;">{r.featuredTitle}</h3>
    <p style="text-align:center; color:var(--text-muted); font-size:0.95rem; margin:-0.75rem 0 1.75rem;">{r.featuredSubtitle}</p>
    <div class="feature-grid" style="margin-bottom:3rem;">
      {r.featured.map((q: any) => (
        <blockquote class="quote-card">
          <p style="margin:0 0 0.5rem;">{q.text}</p>
          <cite style="font-style:normal; font-size:0.85rem; color:var(--accent); font-weight:600;">{q.source}</cite>
        </blockquote>
      ))}
    </div>

    <div class="feature-grid">
      {r.items.map((rev: any) => (
        <div class="review-card">
          <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
            <div class="review-avatar">{rev.name.charAt(0)}</div>
            <div>
              <div style="font-weight:600; color:var(--text-primary);">{rev.name}</div>
              <div style="font-size:0.8rem; color:var(--text-muted);">{rev.date}</div>
            </div>
          </div>
          <div style="margin-bottom:0.6rem;" set:html={stars(rev.rating)}></div>
          <p style="margin:0; color:var(--text-secondary); line-height:1.6; font-size:0.95rem;">{rev.text}</p>
        </div>
      ))}
    </div>

    <div style="text-align:center; margin-top:2rem;">
      <a href={r.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-cta btn-cta-primary" style="display:inline-flex;">
        📍 {r.moreReviews}
      </a>
    </div>
  </div>
</section>
