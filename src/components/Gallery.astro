---
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { pick } from '../data/attractions';
const { poi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;
---
<section id="gallery" class="section">
  <div class="container">
    <h2 class="section-title">Photo Gallery</h2>
    <div class="gallery-grid">
      {poi.images.map((img, i) => (
        <button class="gallery-item" type="button" data-full={img.file} style={`grid-row: span ${i % 3 === 0 ? 2 : 1};`} aria-label={pick(img.caption, lang)}>
          <img src={img.file} alt={pick(img.caption, lang)} loading="lazy" />
        </button>
      ))}
    </div>
    <div class="map-links" style="margin-top:1.25rem;">
      <a class="map-link" href={poi.mapsUrl} target="_blank" rel="noopener">{m.common.viewOnMap} ↗</a>
    </div>
  </div>
</section>

<div id="lightbox" class="lightbox" hidden>
  <button class="lightbox-close" type="button" aria-label="Close">×</button>
  <img id="lightbox-img" src="" alt="" />
</div>

<script>
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lightbox-img');
  document.querySelectorAll('.gallery-item').forEach((el) => {
    el.addEventListener('click', () => {
      lbImg.src = el.dataset.full;
      lb.hidden = false;
    });
  });
  lb?.addEventListener('click', () => { lb.hidden = true; });
</script>

<style>
  .gallery-grid {
    columns: 3 220px; column-gap: 0.85rem;
  }
  .gallery-item {
    display: block; width: 100%; margin: 0 0 0.85rem; padding: 0; border: none;
    border-radius: 12px; overflow: hidden; cursor: zoom-in; background: var(--bg-tertiary);
  }
  .gallery-item img { width: 100%; display: block; transition: transform 0.3s; }
  .gallery-item:hover img { transform: scale(1.04); }
  .lightbox {
    position: fixed; inset: 0; background: rgba(0,0,0,0.88); z-index: 1000;
    display: flex; align-items: center; justify-content: center; padding: 2rem;
  }
  .lightbox[hidden] { display: none; }
  .lightbox img { max-width: 92vw; max-height: 88vh; border-radius: 10px; }
  .lightbox-close {
    position: absolute; top: 1.2rem; right: 1.5rem; font-size: 2rem; color: #fff;
    background: none; border: none; cursor: pointer;
  }
</style>
