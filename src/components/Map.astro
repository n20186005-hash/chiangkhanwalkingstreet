---
import { getLangFromUrl, getI18n, format } from '../i18n/ui';
import { pick } from '../data/attractions';
import { siteConfig } from '../config/site';
const { poi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;
const e = m.entity;
const { lat, lng } = poi.location;

const vars = {
  name: pick(poi.name, lang),
  full: e.placeFull,
  short: e.placeShort,
  city: e.placeCity,
  state: e.placeState,
  country: e.placeCountry,
};
const locationHeading = format(e.locationHeading, vars);
---
<section id="map" class="section section-alt">
  <div class="container">
    <h2 class="section-title">{locationHeading}</h2>
    <p class="section-sub">{m.map.embedNote}</p>

    <iframe
      class="map-embed map-iframe"
      src={siteConfig.mapsEmbedSrc}
      width="100%"
      height="450"
      style="border:0;"
      title={format(e.mapTitle, vars)}
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>

    <div class="map-links">
      <a class="map-link" href={poi.mapsUrl} target="_blank" rel="noopener">{m.map.googleMaps} ↗</a>
      <span class="muted" style="font-size:0.85rem;">{poi.location.plusCode} · {poi.location.address}</span>
    </div>

    <p class="map-gov">
      {e.officialPrefix}{' '}
      <a href={siteConfig.govtTourismUrl} target="_blank" rel="noopener noreferrer">
        {format(e.officialLabel, vars)}
      </a>.
    </p>
    <p class="map-source muted">
      {m.facts.ratingSource}: <a href={poi.ratingSource.url} target="_blank" rel="noopener noreferrer">{poi.ratingSource.name}</a> · {poi.ratingSource.retrieved} · lat {lat}, lng {lng}
    </p>
  </div>
</section>

<style>
  .map-iframe {
    display: block;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    margin-bottom: 1.25rem;
    background: var(--bg-secondary);
  }
  .map-gov {
    margin: 1.25rem 0 0.35rem;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .map-gov a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .map-source {
    font-size: 0.82rem;
    line-height: 1.6;
    margin: 0;
  }
  .map-source a {
    color: var(--accent);
    text-decoration: none;
  }
</style>
