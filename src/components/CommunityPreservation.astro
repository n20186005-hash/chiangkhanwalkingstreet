---
import type { Attraction } from '../data/attractions';
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { pick } from '../data/attractions';

interface Props {
  poi: Attraction;
}

const { poi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;

const hasFolklore = !!poi.folklore;
const hasPreservation = !!poi.preservation;

if (!hasFolklore && !hasPreservation) {
  return null;
}
---

<section id="preservation" class="section section-padding section-alt">
  <div class="container mx-auto">
    <div class="split-layout">
      {hasFolklore && (
        <div class="content-block">
          <h2 class="section-title" style="text-align: left;">{m.headings.folklore}</h2>
          <div class="prose">
            <p>{pick(poi.folklore, lang)}</p>
          </div>
        </div>
      )}

      {hasPreservation && (
        <div class="content-block">
          <h2 class="section-title" style="text-align: left;">{m.headings.preservation}</h2>
          <div class="prose preservation-box">
            <p>{pick(poi.preservation, lang)}</p>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .split-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .split-layout {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
  .prose {
    line-height: 1.8;
    color: var(--text-secondary);
  }
  .preservation-box {
    background: var(--bg-tertiary);
    padding: 2rem;
    border-radius: 16px;
    border-left: 4px solid var(--accent);
    box-shadow: var(--card-shadow);
  }
</style>
