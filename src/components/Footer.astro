---
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { pick } from '../data/attractions';
const { poi, attractionName } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;
const displayName = attractionName ?? pick(poi.name, lang);
const legal = {
  en: { rights: 'All rights reserved.', independent: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.' },
  th: { rights: 'สงวนลิขสิทธิ์', independent: 'เว็บไซต์นี้เป็นโครงการข้อมูลการท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐหรือองค์กรทางการใด ๆ' },
  zh: { rights: '版權所有。', independent: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。' },
}[lang];
---
<nav class="site-policy-links" aria-label={m.footer.privacy}>
  <div class="container">
    <a href={`/${lang}/sources/`}>{m.headings.sources}</a>
    <a href={`/${lang}/privacy/`}>{m.footer.privacy}</a>
    <a href={`/${lang}/terms/`}>{m.footer.terms}</a>
    <a href={`/${lang}/cookies/`}>{m.footer.cookies}</a>
  </div>
</nav>
<footer class="site-footer" id="contact">
  <div class="container footer-bottom" style="text-align:center">
    <p>© 2026 {displayName} · {legal.rights}</p>
    <p>{legal.independent}</p>
  </div>
</footer>
<style>
  .site-policy-links { padding:1.1rem 0; background:var(--bg-alt); border-top:1px solid var(--border-color); }
  .site-policy-links .container { display:flex; gap:1.5rem; justify-content:center; flex-wrap:wrap; }
  .site-policy-links a { color:var(--text-secondary); font-size:.875rem; text-decoration:none; }
  .site-policy-links a:hover { color:var(--accent); text-decoration:underline; }
  .site-footer { padding:1.5rem 0 1.75rem; }
  .footer-bottom { display:grid; gap:.6rem; }
  .footer-bottom p { margin:0; }
</style>
