---
import { getLangFromUrl, getI18n, format } from '../i18n/ui';
import { pick } from '../data/attractions';
const { poi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;
const e = m.entity;

const vars = {
  name: pick(poi.name, lang),
  full: e.placeFull,
  short: e.placeShort,
  city: e.placeCity,
  state: e.placeState,
  country: e.placeCountry,
};

const aboutHeading = format(e.aboutHeading, vars);
const historyHeading = format(e.historyHeading, vars);
const declaration = format(e.declaration, vars);
---
<section id="overview" class="section">
  <div class="container">
    <nav class="breadcrumb geo-breadcrumb" aria-label={e.breadcrumbLabel}>
      <span>{e.placeFull}</span>
      <span aria-hidden="true">›</span>
      <span>{e.placeCity}</span>
      <span aria-hidden="true">›</span>
      <span>{e.placeState}</span>
      <span aria-hidden="true">›</span>
      <span>{e.placeCountry}</span>
    </nav>
    <h2 class="section-title">{aboutHeading}</h2>
    <div class="prose">
      <p class="entity-declaration">{declaration}</p>
      <p>{pick(poi.intro, lang)}</p>
    </div>
  </div>
</section>

<section id="history" class="section section-alt">
  <div class="container">
    <h2 class="section-title">{historyHeading}</h2>
    <div class="prose">
      <p>{pick(poi.history, lang)}</p>
    </div>
  </div>
</section>
