---
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { pick } from '../data/attractions';
const { poi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;
---
<section id="accessibility" class="section section-alt">
  <div class="container">
    <h2 class="section-title">{m.headings.accessibility}</h2>
    <div class="prose">
      <p>{pick(poi.accessibility, lang)}</p>
    </div>
  </div>
</section>
