---
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { pick } from '../data/attractions';
const { poi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;
---
<section id="things-to-do" class="section section-alt">
  <div class="container">
    <h2 class="section-title">{m.headings.thingsToDo}</h2>
    <div class="feature-grid">
      {poi.thingsToDo.map((item) => (
        <div class="feature-card">
          <h3 class="feature-title">{pick(item.title, lang)}</h3>
          <p class="feature-desc">{pick(item.desc, lang)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
