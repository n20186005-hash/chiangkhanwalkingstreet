---
import { getLangFromUrl, getI18n, languages, languagesList, buildAlternates } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;
const { nav = [] } = Astro.props;
const seg = Astro.url.pathname.split('/').filter(Boolean);
const rest = seg.slice(1).join('/');
const alt = buildAlternates(rest);
const langs = languagesList.map((l) => ({ lang: l, label: languages[l] }));
const homeHref = `/${lang}`;
---
<header class="site-header">
  <div class="container site-header-inner">
    <a href={homeHref} class="brand">
      <span class="brand-mark"></span>
      <span class="brand-text">
        <span class="brand-name">{m.brand.name}</span>
        <span class="brand-tagline">{m.brand.tagline}</span>
      </span>
    </a>

    {nav.length > 0 && (
      <nav class="site-nav" aria-label="Sections">
        {nav.map((item) => (
          <a href={item.href} class="nav-link">{item.label}</a>
        ))}
      </nav>
    )}

    <div class="header-tools">
      <div class="lang-switch" role="group" aria-label={m.common.changeLanguage}>
        {langs.map((l) => (
          <a href={alt[l.lang]} class={`lang-btn ${l.lang === lang ? 'active' : ''}`} hreflang={l.lang === 'zh' ? 'zh-CN' : l.lang}>
            {l.label}
          </a>
        ))}
      </div>
      <button class="theme-toggle" type="button" aria-label={m.common.toggleTheme} onclick="document.documentElement.classList.toggle('dark')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
      </button>
    </div>
  </div>
</header>
