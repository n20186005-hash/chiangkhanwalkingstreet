---
import type { Attraction } from '../data/attractions';
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { pick } from '../data/attractions';

interface Props {
  poi: Attraction;
}

const { poi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;

if (!poi.timeline || poi.timeline.length === 0) {
  return null;
}
---

<section id="timeline" class="section">
  <div class="container">
    <h2 class="section-title">{m.headings.timeline}</h2>

    <div class="timeline-container">
      {poi.timeline.map((item, index) => (
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-year">{item.year}</div>
            <p class="timeline-text">{pick(item.event, lang)}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-container {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    padding: 0.5rem 0;
  }
  .timeline-container::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 7px;
    width: 2px;
    background: var(--border-color);
  }
  .timeline-item {
    position: relative;
    margin-bottom: 1.75rem;
    padding-left: 38px;
  }
  .timeline-item:last-child { margin-bottom: 0; }
  .timeline-marker {
    position: absolute;
    top: 6px;
    left: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg-primary);
    box-shadow: 0 0 0 4px var(--border-color);
    z-index: 1;
  }
  .timeline-year {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.35rem;
    text-align: left;
  }
  .timeline-text {
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
    text-align: left;
  }
</style>
