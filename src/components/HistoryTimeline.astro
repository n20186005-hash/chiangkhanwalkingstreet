---
import type { Attraction } from '../data/attractions';
import { getLangFromUrl, getI18n } from '../i18n/ui';
import { pick } from '../data/attractions';

interface Props {
  poi: Attraction;
}

const { poi } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const m = getI18n(Astro.url).messages;

if (!poi.timeline || poi.timeline.length === 0) {
  return null;
}
---

<section id="timeline" class="section">
  <div class="container">
    <h2 class="section-title">{m.headings.timeline}</h2>

    <div class="timeline-container">
      {poi.timeline.map((item, index) => (
        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-year">{item.year}</div>
            <p class="timeline-text">{pick(item.event, lang)}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-container {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 0;
  }
  .timeline-container::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 16px;
    width: 2px;
    background: var(--border-color);
  }
  @media (min-width: 768px) {
    .timeline-container::before {
      left: 50%;
      transform: translateX(-50%);
    }
  }
  .timeline-item {
    position: relative;
    margin-bottom: 2rem;
    padding-left: 48px;
  }
  @media (min-width: 768px) {
    .timeline-item {
      width: 50%;
      padding-left: 0;
      padding-right: 40px;
    }
    .timeline-item:nth-child(even) {
      margin-left: 50%;
      padding-left: 40px;
      padding-right: 0;
    }
  }
  .timeline-marker {
    position: absolute;
    top: 0;
    left: 11px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg-primary);
    box-shadow: 0 0 0 4px var(--border-color);
    z-index: 1;
  }
  @media (min-width: 768px) {
    .timeline-marker {
      left: auto;
      right: -6px;
    }
    .timeline-item:nth-child(even) .timeline-marker {
      left: -6px;
      right: auto;
    }
  }
  .timeline-content {
    background: var(--card-bg);
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    box-shadow: var(--card-shadow);
  }
  .timeline-year {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .timeline-text {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>
