{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiangkhanwalkingstreet",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every URL is served with a trailing slash, matching the canonical tags,
    // the hreflang set and the sitemap. Requests without one are redirected,
    // so Google only ever sees a single address per page.
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
